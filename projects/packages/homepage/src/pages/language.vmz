<script client>
export default class LanguagePage {
    primer = `namespace motif_a;

intent {
  emotion "urgent resolve" intensity 0.8 for theme
}

orchestrate for theme {
  hard_constraints: ["keep the motif recognizable"]
  soft_preferences: ["strings before brass"]
}

timeline {
  act theme : 0..8
}

tempo { at 0 bpm 120 }

music for theme {
  key "C major"
  meter 4/4
  motif "C4 E4 G4 C5"
}`;
}
