<script client>
export default class IndexPage {
    installSample = "npm install -g @muse-gpt/muse\nmuse doctor\nmuse init demo && cd demo && muse check main.muse";

    async copyInstall() {
        const text = String(this.installSample || "");
        if (!text || typeof navigator === "undefined" || !navigator.clipboard?.writeText) return;
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            /* ignore */
        }
    }
}
</script>
