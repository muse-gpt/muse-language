<template>
  <div class="muse-home">
    <header class="muse-site-header">
      <Link class="muse-site-header__brand" href="/"><strong>Muse</strong></Link>
      <nav class="muse-site-header__nav" aria-label="Primary">
        <Link href="/">Home</Link>
        <Link href="/language">Language</Link>
        <Link href="/start">Get started</Link>
      </nav>
    </header>
    <main>
      <section class="muse-home__hero" aria-labelledby="muse-hero-title">
        <Badge tone="brand">Audiovisual composition language</Badge>
        <h1 id="muse-hero-title">Compose what you mean.</h1>
        <p class="muse-home__lede">
          Muse turns creative direction into a deterministic plan for sound, image, and time.
          Keep the human part human. Let the system carry the rest.
        </p>
        <div class="muse-home__actions">
          <Link href="/start"><Button type="button" variant="primary">Start composing</Button></Link>
          <Link href="/language"><Button type="button" variant="secondary">See the language</Button></Link>
        </div>
      </section>

      <section class="muse-home__grid" aria-label="Layers">
        <Card title="intent" description="Record the why: emotion, references, and atmosphere worth protecting." />
        <Card title="orchestrate" description="Map sound, image, color, and motion under hard constraints and soft preferences." />
        <Card title="timeline / music / visual" description="Executable blocks that render engines consume without rewriting Muse semantics." />
      </section>

      <section class="muse-home__install" aria-label="Install">
        <Card title="Install" description="Install the muse CLI globally, then check and preview a starter script.">
          <CodeBlock
            :code="installSample"
            caption="shell"
            copy-label="Copy"
            @copy="() => this.copyInstall()"
          />
        </Card>
      </section>
    </main>
  </div>
</template>

