{
    "name": "@muse/muse",
    "version": "0.0.0",
    "description": "Muse audiovisual composition language — CLI and Node entry",
    "type": "module",
    "license": "MPL-2.0",
    "bin": {
        "muse": "bin/muse"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./src/index.ts",
        "./cli": "./src/cli/index.ts"
    },
    "files": [
        "bin",
        "locales",
        "readme.md",
        "src"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@vmz/commander": "^0.2.0",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@muse/muse-darwin-arm64": "workspace:*",
        "@muse/muse-darwin-x64": "workspace:*",
        "@muse/muse-linux-arm64": "workspace:*",
        "@muse/muse-linux-x64": "workspace:*",
        "@muse/muse-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/muse-gpt/muse-language.git",
        "directory": "projects/packages/muse"
    }
}
