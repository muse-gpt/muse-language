{
    "name": "muse-language",
    "displayName": "Muse Language",
    "description": "Syntax highlighting and language guide for Muse (.muse) audiovisual composition scripts",
    "version": "0.0.0",
    "publisher": "muse-gpt",
    "license": "MPL-2.0",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Themes"
    ],
    "keywords": [
        "muse",
        "audiovisual",
        "composition",
        "syntax",
        "highlighting"
    ],
    "activationEvents": [
        "onLanguage:muse"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "muse",
                "aliases": [
                    "Muse",
                    "muse"
                ],
                "extensions": [
                    ".muse"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "muse",
                "scopeName": "source.muse",
                "path": "./syntaxes/muse.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "Muse",
                "uiTheme": "vs-dark",
                "path": "./themes/muse-color-theme.json"
            }
        ],
        "commands": [
            {
                "command": "muse.openGuide",
                "title": "Muse: Open Language Guide"
            }
        ]
    },
    "homepage": "https://github.com/muse-gpt/muse-language#readme",
    "bugs": {
        "url": "https://github.com/muse-gpt/muse-language/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/muse-gpt/muse-language.git",
        "directory": "projects/packages/muse-for-vscode"
    }
}
