{
    "private": true,
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "build": "cargo build --release",
        "test": "cargo test --release",
        "typecheck": "pnpm --filter @muse-gpt/muse typecheck",
        "dev": "pnpm --filter @muse-gpt/homepage dev",
        "build:homepage": "pnpm --filter @muse-gpt/homepage build",
        "homepage:check": "pnpm --filter @muse-gpt/homepage check",
        "fmt": "biome format --write .",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.0.12",
        "@biomejs/biome": "2.5.7",
        "@muse-gpt/muse": "workspace:*"
    }
}
